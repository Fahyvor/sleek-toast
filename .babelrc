{
  "presets": [
    ["@babel/preset-env", { 
      "targets": { "browsers": ["> 1%", "last 2 versions"] },
      "modules": false
    }],
    ["@babel/preset-react", { "runtime": "classic" }],
    ["@babel/preset-typescript", { 
      "isTSX": true, 
      "allExtensions": true,
      "onlyRemoveTypeImports": true
    }]
  ],
  "plugins": [
    "@babel/plugin-proposal-class-properties",
    "@babel/plugin-proposal-object-rest-spread"
  ]
}